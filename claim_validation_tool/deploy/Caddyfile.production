# HTTPS on a server: Caddy gets and renews a Let's Encrypt certificate for RCM_DOMAIN by
# itself (ports 80 and 443 must reach the server, and the domain's DNS must point at it).
#
#   RCM_DOMAIN=rcm.example.com RCM_FRONTEND_DIST=/srv/claustrarcm/frontend/dist \
#     caddy run --config Caddyfile.production --adapter caddyfile
#
# The API runs on the same server, reachable only from it:
#   RCM_ENVIRONMENT=production RCM_COOKIE_SECURE=1 RCM_ALLOWED_ORIGINS=https://rcm.example.com \
#     uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
# (uvicorn trusts X-Forwarded-For from 127.0.0.1 by default, so the audit log records the
# real client address.)

import security-headers.caddy

{$RCM_DOMAIN} {
	encode zstd gzip
	import security_headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Everything the app loads is its own; inline style attributes come from React
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		root * {$RCM_FRONTEND_DIST}
		try_files {path} /index.html
		file_server
	}
}

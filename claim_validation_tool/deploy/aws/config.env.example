# Settings for the AWS pilot server. Copy to config.env and fill in BUDGET_EMAIL.
# provision.sh and deploy.sh read config.env from this folder.

# Name used for every AWS resource (tags, the KMS alias, the IAM role, the bucket prefix)
NAME=vericlaim-pilot
REGION=us-east-1

# Smallest that works: 2 vCPU, 1 GB memory (plus a 2 GB swap file). ~$6.10/month.
# Move to t4g.small (2 GB, ~$12.30/month) only if memory runs short.
INSTANCE_TYPE=t4g.micro
DISK_GB=20

# Monthly budget alert: an email at 50% and 100% of this, and when the forecast passes it
BUDGET_USD=20
BUDGET_EMAIL=

# The web address. Leave empty until a domain is bought: the server then uses
# <its-IP-with-dashes>.sslip.io, a free name that points at the IP, with a real HTTPS
# certificate. Set it later (and point the domain's DNS at the server's IP), then redeploy.
DOMAIN=

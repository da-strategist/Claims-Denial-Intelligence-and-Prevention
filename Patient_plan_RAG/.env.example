# AI Provider — required for RAG answer generation
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER

# Application mode: "demo" uses cached/synthetic responses when no API key is set
# "live" requires a valid ANTHROPIC_API_KEY
APP_MODE=demo

# Server
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5174

# Document storage (relative to backend/)
UPLOAD_DIR=app/data/uploads
POLICY_DIR=app/data/policies
CHUNK_DIR=app/data/chunks

# Retrieval settings
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

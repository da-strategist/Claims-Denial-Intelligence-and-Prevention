# Copy to .env and start the backend with:
#   uvicorn backend.app.main:app --reload --port 8001 --env-file .env
# Every variable below is optional; the values shown are the defaults.

# Application mode: "demo" builds answers from templates (no API key needed).
# "live" calls the Anthropic API and requires ANTHROPIC_API_KEY.
APP_MODE=demo
# ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER

# Comma-separated origins allowed to call the API directly (the Vite dev
# server proxies /api, so this only matters without the proxy).
CORS_ORIGINS=http://localhost:5174

# Data directories. Relative paths resolve against the directory uvicorn is
# started from; the defaults are <project>/data/{uploads,policies,chunks}.
# UPLOAD_DIR=data/uploads
# POLICY_DIR=data/policies
# CHUNK_DIR=data/chunks

# Input limits. Rate limits are per client IP, in-memory, per worker.
# MAX_UPLOAD_MB=20
# RATE_LIMIT_PER_MINUTE=60
# UPLOAD_RATE_LIMIT_PER_MINUTE=10

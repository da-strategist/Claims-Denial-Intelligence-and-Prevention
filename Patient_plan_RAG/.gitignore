# Python
__pycache__/
*.py[oc]
.venv/
*.egg-info/

# Environment
.env

# Node / Frontend
node_modules/
frontend/dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Logs
*.log

# Runtime data: chunks, uploads and the registry are rebuilt at startup
data/chunks/
data/uploads/
data/policies/_registry.json
# Accounts: password hashes, never committed
data/users.json
data/users.tmp
# Audit log: who accessed what
data/audit.log

# The root .gitignore drops *.json; the npm manifests are needed to install
!frontend/package.json
!frontend/package-lock.json
